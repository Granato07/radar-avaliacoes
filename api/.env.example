# Copie para .env e preencha. Nunca faça commit do .env.
# LLM principal: Groq (console.groq.com). Reserva: Gemini (aistudio.google.com).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-latest
LLM_TIMEOUT_MS=10000
ORIGENS_PERMITIDAS=http://localhost:3000
LIMITE_POR_MINUTO=20
PORT=3333
